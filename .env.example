# Скопируйте этот файл в .env:
#   cp .env.example .env
#
# По умолчанию — SQLite (ничего устанавливать не нужно):
DATABASE_URL=sqlite+aiosqlite:///./checkstock.db

# Для PostgreSQL раскомментируйте и укажите свои данные:
# DATABASE_URL=postgresql+asyncpg://checkstock:checkstock@localhost:5432/checkstock
